{
  "name": "everise-frontend",
  "version": "19.0.2",
  "license": "MIT",
  "scripts": {
    "start": "nx run conduit:serve --host 0.0.0.0 --configuration=debug",
    "build": "npx nx run conduit:build --configuration=production",
    "start-sw": "nx reset && npx nx build conduit --configuration=debug && npx wrangler dev",
    "lint": "npx nx affected -t lint",
    "format": "npx nx format:check --affected",
    "format:write": "npx nx format:write --affected",
    "e2e": "npx nx run conduit-e2e:e2e",
    "test": "npx nx affected -t test",
    "deploy:staging": "npx nx run conduit:build --configuration=staging && npx wrangler deploy --env staging",
    "deploy": "npx nx run conduit:build --configuration=production && npx wrangler deploy"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.1.8",
    "@angular/compiler": "22.1.8",
    "@angular/core": "22.1.8",
    "@angular/forms": "22.1.8",
    "@angular/platform-browser": "22.1.8",
    "@angular/platform-browser-dynamic": "22.1.8",
    "@angular/router": "22.1.8",
    "@angular/service-worker": "22.1.8",
    "@ngrx/eslint-plugin": "22.0.1",
    "@ngrx/operators": "22.0.1",
    "@ngrx/signals": "22.0.1",
    "@nx/angular": "23.2.1",
    "marked": "5.0.1",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.6.4",
    "@analogjs/vitest-angular": "2.6.4",
    "@angular-devkit/architect": "0.2201.9",
    "@angular-devkit/build-angular": "22.1.9",
    "@angular-devkit/core": "22.1.9",
    "@angular-devkit/schematics": "22.1.9",
    "@angular-eslint/eslint-plugin": "22.5.0",
    "@angular-eslint/eslint-plugin-template": "22.5.0",
    "@angular-eslint/template-parser": "22.5.0",
    "@angular/cli": "22.1.9",
    "@angular/compiler-cli": "22.1.8",
    "@angular/language-service": "22.1.8",
    "@angular/pwa": "22.1.9",
