{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2017", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@everise/articles/article": ["./libs/articles/feature-article/src/index.ts"],
      "@everise/articles/article-edit": ["./libs/articles/feature-article-edit/src/index.ts"],
      "@everise/articles/articles-list": ["./libs/articles/feature-articles-list/src/index.ts"],
      "@everise/articles/data-access": ["./libs/articles/data-access/src/index.ts"],
      "@everise/auth/data-access": ["./libs/auth/data-access/src/index.ts"],
      "@everise/auth/feature-auth": ["./libs/auth/feature-auth/src/index.ts"],
      "@everise/media": ["./libs/media/feature-media/src/index.ts"],
      "@everise/media/data-access": ["./libs/media/data-access/src/index.ts"],
      "@everise/core/api-types": ["./libs/core/api-types/src/index.ts"],
      "@everise/core/data-access": ["./libs/core/data-access/src/index.ts"],
      "@everise/core/error-handler": ["./libs/core/error-handler/src/index.ts"],
      "@everise/core/forms": ["./libs/core/forms/src/index.ts"],
      "@everise/core/http-client": ["./libs/core/http-client/src/index.ts"],
      "@everise/core/testing": ["./libs/core/testing/src/index.ts"],
      "@everise/home/feature-home": ["./libs/home/feature-home/src/index.ts"],
      "@everise/profile/data-access": ["./libs/profile/data-access/src/index.ts"],
      "@everise/profile/feature-profile": ["./libs/profile/feature-profile/src/index.ts"],
      "@everise/roulette/data-access": ["./libs/roulette/data-access/src/index.ts"],
      "@everise/roulette/feature-roulette": ["./libs/roulette/feature-roulette/src/index.ts"],
      "@everise/waking-sands/data-access": ["./libs/waking-sands/data-access/src/index.ts"],
      "@everise/waking-sands/feature-waking-sands": ["./libs/waking-sands/feature-waking-sands/src/index.ts"],
      "@everise/settings/data-access": ["./libs/settings/data-access/src/index.ts"],
      "@everise/settings/feature-settings": ["./libs/settings/feature-settings/src/index.ts"],
      "@everise/ui/components": ["./libs/ui/components/src/index.ts"]
    },
    "strict": true
  },
  "exclude": ["node_modules", "tmp"]
}
