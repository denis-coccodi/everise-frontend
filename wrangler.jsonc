{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "conduit-web",
  "compatibility_date": "2026-09-01",

  // Static files only: the Angular build, with index.html for unknown paths so
  // deep links work. The app calls its backend directly; which one is baked in
  // at build time (src/environments/*), so build with the matching configuration
  // before deploying: `--configuration=production` here, `--configuration=staging`
  // for `--env staging`.
  "assets": {
    "directory": "./dist/apps/conduit",
    "not_found_handling": "single-page-application"
  },

  "observability": { "enabled": true },

  "dev": { "port": 4200 },

  // `wrangler deploy --env staging` deploys a separate Worker, "conduit-web-staging".
  "env": {
    "staging": {}
  }
}
