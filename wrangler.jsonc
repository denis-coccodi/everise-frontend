{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Production Worker. The name must match the Worker in Cloudflare exactly, or
  // `wrangler deploy` creates a new Worker instead of updating this one.
  "name": "prod",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",

  // The Angular build, with index.html for unknown paths so deep links work.
  // Build with the matching configuration before deploying:
  // `--configuration=production` here, `--configuration=staging` for `--env staging`.
  // /api/* runs the Worker first (worker/index.ts), which forwards it to the backend.
  "assets": {
    "directory": "./dist/apps/everise",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The API, and the pages that get their own tags and words (worker/seo).
    "run_worker_first": [
      "/api/*",
      "/article/*",
      "/",
      "/home",
      "/party-finder",
      "/party-finder/*",
      "/roulette",
      "/waking-sands",
      "/privacy",
      "/login",
      "/register",
      "/robots.txt",
      "/sitemap.xml"
    ]
  },

  // The backend Worker of this environment, reached inside Cloudflare (not over
  // the public internet): the app calls the relative /api and this site forwards it.
  "services": [{ "binding": "API", "service": "be-prod" }],

  // The site's address for canonical URLs, and whether search engines may
  // index it (only production).
  "vars": { "SITE_URL": "https://everise.dev", "SEARCH_ENGINES": "allow" },

  // The site's address. Its workers.dev address stays on for links saved
  // before the move (pictures, uploads, emails).
  "routes": [{ "pattern": "everise.dev", "custom_domain": true }],
  "workers_dev": true,

  "observability": { "enabled": true },

  "dev": { "port": 4200 },

  // `wrangler deploy --env staging` deploys a separate Worker, "staging".
  // Service bindings are not inherited, so the staging backend is set here.
  "env": {
    "staging": {
      // Set explicitly: the default would be "prod-staging".
      "name": "staging",
      // Not inherited either.
      "routes": [{ "pattern": "staging.everise.dev", "custom_domain": true }],
      "workers_dev": true,
      "services": [{ "binding": "API", "service": "be-staging" }],
      // Not inherited: staging keeps search engines away.
      "vars": { "SITE_URL": "https://staging.everise.dev", "SEARCH_ENGINES": "block" }
    }
  }
}
